# Onde o seu PHP está rodando (XAMPP/Apache). O Vite repassa /intelbras/* pra lá,
# então a sessão (cookie PHPSESSID) e o CSRF funcionam no mesmo domínio.
VITE_PHP_ORIGIN=http://localhost

# Pasta do projeto PHP dentro do Apache (http://localhost/intelbras/)
VITE_PHP_BASE=/intelbras

# Onde o build do React será servido em produção (http://localhost/intelbras/react/)
VITE_APP_BASE=/intelbras/react/
